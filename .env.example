# Environment Variables for PlantPal

# ========================================
# SUPABASE (Required for full functionality)
# ========================================
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ========================================
# APP MODE
# ========================================
# Set to 'demo' to use localStorage demo mode (no Supabase required)
# Set to 'production' to use Supabase
VITE_APP_MODE=demo

# ========================================
# WEATHER API (Optional)
# ========================================
# Uses Open-Meteo (free, no key required) for basic weather
# Set a city name for default weather location
VITE_DEFAULT_WEATHER_CITY=

# ========================================
# WEB PUSH / VAPID (Optional - for push notifications)
# ========================================
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ========================================
# APP SETTINGS
# ========================================
VITE_APP_NAME=PlantPal
VITE_APP_URL=http://localhost:5173

# NOTE: Never commit actual secret values to version control.
# The SUPABASE_SERVICE_ROLE_KEY and email API keys must ONLY be used
# in server-side Supabase Edge Functions, never in the browser.
